{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 14,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/.build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "dev-debug",
            "displayName": "Developer Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "dev-release",
            "displayName": "Developer Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ci-debug",
            "displayName": "CI Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ci-release",
            "displayName": "CI Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ci-clang-tidy",
            "displayName": "CI clang-tidy",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_CXX_CLANG_TIDY": "clang-tidy"
            }
        },
        {
            "name": "ci-sanitizers",
            "displayName": "CI Address/UB Sanitizers",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-g -O1 -fsanitize=address,undefined -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-fsanitize=address,undefined",
                "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "-fsanitize=address,undefined"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-dev-debug",
            "configurePreset": "dev-debug"
        },
        {
            "name": "build-dev-release",
            "configurePreset": "dev-release"
        },
        {
            "name": "build-ci-debug",
            "configurePreset": "ci-debug"
        },
        {
            "name": "build-ci-release",
            "configurePreset": "ci-release"
        },
        {
            "name": "build-ci-clang-tidy",
            "configurePreset": "ci-clang-tidy"
        },
        {
            "name": "build-ci-sanitizers",
            "configurePreset": "ci-sanitizers"
        }
    ],
    "testPresets": [
        {
            "name": "test-dev-debug",
            "configurePreset": "dev-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test-dev-release",
            "configurePreset": "dev-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test-ci-debug",
            "configurePreset": "ci-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test-ci-release",
            "configurePreset": "ci-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test-ci-sanitizers",
            "configurePreset": "ci-sanitizers",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}